{
    "name": "smoke",
    "cfgs": {
        "timelimit": "00:20:00",
        "memorylimit": "8GB",
        "slurm-time-headroom": "00:05:00",
        "slurm-memory-headroom": "1GB",
        "slurm": {
            "cpus-per-task": 1,
            "partition": null,
            "account": null,
            "qos": null,
            "max-parallel-jobs": 50,
            "max-array-size": 1000,
            "extra-directives": []
        }
    },
    "pools": {
        "requested-k": [
            1000
        ],
        "include-domains": [
            "gripper",
            "rovers",
            "elevators"
        ],
        "exclude-domains": [],
        "min-behaviour-count": 0,
        "min-plans": 20,
        "require-resources": false,
        "max-pools-per-domain": 1,
        "max-pools": 3,
        "selection": "even"
    },
    "experiments": {
        "seed": 2026,
        "k-nn": 3,
        "multiset-stability": true,
        "a": {
            "enabled": true,
            "k": 20,
            "repeats": 2,
            "pool-sizes": [
                25,
                50,
                100
            ],
            "k-sweep": [
                5,
                20
            ]
        },
        "b": {
            "enabled": true,
            "k": 20,
            "hidden-draws": 10
        },
        "c": {
            "enabled": true,
            "k": 20,
            "step": 0.25,
            "require-varying-ru": false
        }
    }
}
